../bochs-2.6.8/configure \
	--prefix="$PREFIX" \
	--enable-debugger \
	--enable-disasm \
	--disable-docbook \
	--disable-x86-64 \
	--enable-pci \
	--enable-all-optimizations \
	--disable-plugins \
	--enable-cdrom \
	--enable-a20-pin \
	--enable-fpu \
	--enable-alignment-check \
	--enable-large-ramfile \
	--disable-debugger-gui \
	--enable-readline \
	--enable-iodebug \
	--enable-xpm \
	--disable-show-ips \
	--enable-logging \
	--enable-usb \
	--enable-ne2000 \
	--enable-cpu-level=6 \
	--disable-sb16 \
	--enable-clgd54xx \
	--with-term \
	--with-nogui \
	--with-x11
