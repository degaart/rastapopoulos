;
; vim: syntax=asm:
; Return to real mode to call int10
; and get back to protected mode
; Place this code at 0:0x7C00
;
BITS 16

%include "int10.inc"
ORG INT10_ORG

start:
    ; We're in 16-bit protected mode
    ; Assume interrupts already cleared
    ; Adjust segment registers
    cli
    mov     ax, cs
    add     ax, 0x08
    mov     ds, ax
    mov     es, ax
    mov     fs, ax
    mov     gs, ax
    mov     ss, ax

    mov     esp, INT10_STACK                ; stack must be accessible

    ; Disable PE bit
    mov     eax, cr0
    and     eax, 0xFFFFFFFF & ~0x00000001   ; PE (the bitwise `and` is there to fix a nasm warning)
    and     eax, 0xFFFFFFFF & ~0x80000000   ; PG
    mov     cr0, eax

    ; load real-mode idt
    mov     eax, idt16
    lidt    [eax]

    ; far jump to real-mode code
    jmp     0x0:rmode

rmode:
    ; We're now in real mode
    mov     ax, cs
    mov     ds, ax
    mov     es, ax
    mov     fs, ax
    mov     gs, ax
    mov     ss, ax
    mov     sp, INT10_STACK

    ; Check 32-bit PM stub correctly wrote params
    ;
    ; param0        [ebp + 8] 0x7D00      [INT10_SCRATCH + 0]    uint32_t[8]. Registers to pass to int 10h.
    ; esp                     0x7D20      [INT10_SCRATCH + 32]   Original esp value.
    ; .return_addr            0x7D24      [INT10_SCRATCH + 36]   Protected mode return address.
    ; cs                      0x7D28      [INT10_SCRATCH + 40]   PM code segment. Zero-extended.
    ; ds                      0x7D2C      [INT10_SCRATCH + 44]   PM data segment. Zero-extended.
    ; idtr                    0x7D30      [INT10_SCRATCH + 48]   Original IDTR. 8 bytes.
    ; gdtr                    0x7D38      [INT10_SCRATCH + 56]   Original GDTR. 12 bytes.
    ; sentinel                0x7D44      [INT10_SCRATCH + 68]   Sentinel. 0xDEADBEEF
    ;
    mov     eax, [INT10_SCRATCH + P_SENTINEL]
    cmp     eax, INT10_SENTINEL
    jne     bad_params

    mov     eax, [INT10_SCRATCH + P_EAX]
    mov     ebx, [INT10_SCRATCH + P_EBX]
    mov     ecx, [INT10_SCRATCH + P_ECX]
    mov     edx, [INT10_SCRATCH + P_EDX]
    mov     ebp, [INT10_SCRATCH + P_EBP]
    mov     esi, [INT10_SCRATCH + P_ESI]
    mov     edi, [INT10_SCRATCH + P_EDI]

    ; Call int 0x10
    int     0x10

    ; Save registers back into storage
    mov     [INT10_SCRATCH + P_EAX], eax
    mov     [INT10_SCRATCH + P_EBX], ebx
    mov     [INT10_SCRATCH + P_ECX], ecx
    mov     [INT10_SCRATCH + P_EDX], edx
    mov     [INT10_SCRATCH + P_EBP], ebp
    mov     [INT10_SCRATCH + P_ESI], esi
    mov     [INT10_SCRATCH + P_EDI], edi
    pushf
    xor     eax, eax
    pop     ax
    mov     [INT10_SCRATCH + P_EFLAGS], eax

    ; Now, we need to transition back to PM
    ; Use a temporary GDT, as the old gdt is probably in a paged area
    break
    mov     ax, [INT10_SCRATCH + P_GDTR]
    mov     [gdt32.limit], ax
    mov     eax, [INT10_SCRATCH + P_GDTR + 2]
    sub     eax, 0xC0000000
    mov     [gdt32.base], eax
    lgdt    [gdt32]

    mov     eax, cr0
    or      eax, 0x00000001             ; PE
    mov     cr0, eax

    ; Assume PE kernel code segment is 0x08
    jmp     0x08:pmode

bad_params:
    mov     ax, bad_params_str
    call    debug_write
    jmp     $

debug_write:
    push    si
    mov     si, ax
.write_loop:
    mov     al, [si]
    cmp     al, 0
    jz      .return

    out     0xE9, al
    inc     si
    jmp     .write_loop
.return:
    pop si
    ret

pmode:
    BITS    32
    mov     ax, 0x10                    ; assume kernel data segment is 0x10
    mov     ds, ax
    mov     es, ax
    mov     fs, ax
    mov     gs, ax
    mov     ss, ax

    mov     eax, cr3
    mov     cr3, eax
    
    mov     eax, cr0
    or      eax, 0x80000000             ; PG
    mov     cr0, eax

    mov     eax, [INT10_SCRATCH + P_ESP]
    mov     esp, eax

    ; reload gdt to it's virtual address
    break
    lgdt    [INT10_SCRATCH + P_GDTR]

    ; load idt with virtual address
    xor     eax, eax
    mov     ax, [INT10_SCRATCH + P_IDTR]
    mov     ebx, [INT10_SCRATCH + P_IDTR + 2]
    lea     eax, [INT10_SCRATCH + P_IDTR]
    lidt    [eax]

    lea     eax, [INT10_SCRATCH + P_RET]
    jmp     [eax]

    jmp     $                           ; infinite loop

; Real-mode idt
idt16:
    dw      0x3FF               ; limit (4 bytes * 255 - 1) 
    dd      0x0                 ; base

; Temporary GDTR
gdt32:
    .limit: dw 0
    .base:  dd 0

hello: db "It works!"
hello_end:

bad_params_str: db "Bad parameters passed to real-mode stub!", 10, 0


