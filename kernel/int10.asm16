;
; vim: syntax=asm:
; Return to real mode to call int10
; and get back to protected mode
; Place this code at 0:0x7C00
;
BITS 16
ORG 0x7C00

start:
    ; We're in 16-bit protected mode
    ; Assume interrupts already cleared
    ; Adjust segment registers
    cli
    mov     ax, cs
    add     ax, 0x08
    mov     ds, ax
    mov     es, ax
    mov     fs, ax
    mov     gs, ax
    mov     ss, ax

    mov     esp, 0x7E00                     ; stack must be accessible

    ; Disable PE bit
    mov     eax, cr0
    and     eax, 0xFFFFFFFF & ~0x00000001   ; PE
    and     eax, 0xFFFFFFFF & ~0x80000000   ; PG
    mov     cr0, eax

    ; load real-mode idt
    mov     eax, idt
    lidt    [eax]

    ; far jump to real-mode code
    jmp     0x0:rmode

rmode:
    ; We're now in real mode
    mov     ax, cs
    mov     ds, ax
    mov     es, ax
    mov     fs, ax
    mov     gs, ax
    mov     ss, ax
    mov     sp, 0x7E00

    ; Write message to screen as a celebration
    xchg    bx, bx
	mov     ah, 0x13                    ; function
	mov     al, 1                       ; update cursor
	mov     bh, 0                       ; page
	mov     bl, 0x07                    ; attribute
	mov     cx, (hello_end - hello)
    mov     dh, 0                       ; row
    mov     dl, 0                       ; col
    mov     bp, hello
	int     0x10

    jmp     $                           ; infinite loop


; Real-mode idt
idt:
    dw      0x3FF               ; limit (4 bytes * 255 - 1) 
    dd      0x0                 ; base

hello: db "It works!"
hello_end:

